# ===========================================================================
#  SilverEye .gitignore
# ===========================================================================

# --------------------------------------------------------------- 密钥 / 凭据
# pass.txt 里是 GitHub PAT，绝对不能进仓库
pass.txt
# providers.json 存各生图引擎的 API Key（服务端配置），同样不能进仓库
providers.json
*.pem
*.key
.env
.env.*
secrets.json

# --------------------------------------------------------------- 临时与缓存
_tmp/
_tmp/**
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.cache/

# --------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------------- 生成物
# 用户实拍的照片不入库（内置演示作品 demo-*.jpg 体积小且是"出厂内容"，保留）
web/assets/gallery/[0-9]*.png
web/assets/gallery/[0-9]*.jpg
# 出图产生的临时文件
*.tmp.png
*.partial
